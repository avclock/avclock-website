{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avclock-website",
  "compatibility_date": "2026-08-11",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
    // REVERTED "html_handling": "none" -- it caused a full site
    // outage (confirmed live: "/" started 404ing, only "/index.html"
    // still served). "none" turns off ALL automatic URL resolution,
    // including "/" -> "/index.html", not just the .html-to-
    // extensionless redirect it was meant to stop. Back on the
    // Cloudflare default ("auto-trailing-slash") for now. The real
    // indexing-duplicate problem (Google discovering both /page.html
    // and /page) still needs a fix, but it has to be one that keeps
    // "/" itself working -- e.g. canonical tags pointing at the
    // .html URL, not a global html_handling override. Don't
    // re-apply "none" without testing "/" locally first.
  },
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_KV",
      "id": "168ad92aa481453689d445039cdf40e1"
    }
  ]
}
