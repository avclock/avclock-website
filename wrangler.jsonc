{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avclock-website",
  "compatibility_date": "2026-08-11",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
    // NOTE: "html_handling": "none" was tried and reverted -- it
    // caused a full site outage (confirmed live: "/" started
    // 404ing, only "/index.html" still served). "none" turns off
    // ALL automatic URL resolution, including "/" -> "/index.html",
    // not just the .html-to-extensionless redirect it was meant to
    // stop. Staying on the Cloudflare default ("auto-trailing-slash")
    // for html_handling -- the duplicate-URL/indexing problem is
    // instead fixed via canonical tags pointing at the extensionless
    // URL Cloudflare actually serves (see canonical tags site-wide).
    // Don't re-apply "none" without testing "/" locally first.
  },
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_KV",
      "id": "168ad92aa481453689d445039cdf40e1"
    }
  ]
}
